<UserControl
    x:Class="serial_console_dotnet.Controls.AddressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:serial_console_dotnet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto, Auto" Height="36">
        <Button x:Name="BackButton" Grid.Column="0" Click="BackButton_Click" Style="{StaticResource OutlineButtonStyle}" Padding="8" Margin="0,0,4,0" IsEnabled="False" ToolTipService.ToolTip="Back">
            <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="12" />
        </Button>
        <Button x:Name="ForwardButton" Grid.Column="1" Click="ForwardButton_Click" Style="{StaticResource OutlineButtonStyle}" Padding="8" Margin="0,0,4,0" IsEnabled="False" ToolTipService.ToolTip="Forward">
            <FontIcon Glyph="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="12" />
        </Button>
        <Button x:Name="UpButton" Grid.Column="2" Click="UpButton_Click" Style="{StaticResource OutlineButtonStyle}" Padding="8" Margin="0,0,4,0" ToolTipService.ToolTip="Up to Parent">
            <FontIcon Glyph="&#xE197;" FontFamily="Segoe Fluent Icons" FontSize="12" />
        </Button>
        <Button x:Name="RefreshButton" Grid.Column="3" Click="RefreshButton_Click" Style="{StaticResource OutlineButtonStyle}" Padding="8" Margin="0,0,8,0" ToolTipService.ToolTip="Refresh">
            <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" />
        </Button>

        <!-- Draggable/Editable Address Bar Grid (Clicking blank space enters text editing) -->
        <Border Grid.Column="4" Background="#0C1324" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" PointerPressed="AddressBar_PointerPressed">
            <Grid x:Name="AddressBarGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Breadcrumbs view -->
                <ScrollViewer x:Name="BreadcrumbsScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" Spacing="4" />
                </ScrollViewer>

                <!-- TextBox for direct text editing -->
                <TextBox x:Name="AddressTextBox" Grid.Column="0" Visibility="Collapsed" BorderThickness="0" Background="Transparent" Foreground="#F2F4F7" FontFamily="Consolas" VerticalAlignment="Center" KeyDown="AddressTextBox_KeyDown" LostFocus="AddressTextBox_LostFocus" Padding="0,2" />

                <!-- Edit path icon indicator -->
                <FontIcon Grid.Column="1" Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
            </Grid>
        </Border>

        <!-- View toggles: Icon & List -->
        <Button x:Name="ListViewBtn" Grid.Column="5" Click="ViewModeBtn_Click" Tag="list" Style="{StaticResource OutlineButtonStyle}" Padding="8" Margin="8,0,4,0" ToolTipService.ToolTip="List View">
            <FontIcon Glyph="&#xE179;" FontFamily="Segoe Fluent Icons" FontSize="12" />
        </Button>
        <Button x:Name="IconViewBtn" Grid.Column="6" Click="ViewModeBtn_Click" Tag="icon" Style="{StaticResource OutlineButtonStyle}" Padding="8" ToolTipService.ToolTip="Icon View">
            <FontIcon Glyph="&#xE80A;" FontFamily="Segoe Fluent Icons" FontSize="12" />
        </Button>
    </Grid>
</UserControl>
