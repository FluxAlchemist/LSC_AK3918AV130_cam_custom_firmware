<UserControl
    x:Class="serial_console_dotnet.Controls.DeviceExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:serial_console_dotnet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d">

    <Grid Background="#151E2E" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Row 0: Address Bar -->
            <RowDefinition Height="*" />    <!-- Row 1: Sidebar & Contents -->
            <RowDefinition Height="Auto" /> <!-- Row 2: Progress & Buttons -->
        </Grid.RowDefinitions>

        <!-- Row 0: Modular Address Bar -->
        <local:AddressBar x:Name="ExplorerAddressBar" Grid.Row="0" Margin="0,0,0,12" />

        <!-- Row 1: Sidebar & Contents split -->
        <Grid Grid.Row="1" ColumnDefinitions="200, 8, *" Margin="0,0,0,12">
            <!-- Left Sidebar (Favorites) -->
            <Border Grid.Column="0" Background="#0C1324" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                <local:FavoritesSidebar x:Name="ExplorerSidebar" />
            </Border>

            <!-- Spacer -->
            <Grid Grid.Column="1" />

            <!-- Contents area -->
            <Border Grid.Column="2" Background="#0C1324" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6">
                <local:DirectoryContentsView x:Name="ExplorerContents" />
            </Border>
        </Grid>

        <!-- Row 2: FTP Credentials / Progress / Action Buttons -->
        <Grid Grid.Row="2" RowDefinitions="Auto, Auto, Auto">
            <!-- FTP credentials Panel (Always active, hidden by default) -->
            <StackPanel x:Name="FtpSettingsPanel" Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,12" Background="#1D2939" Padding="12,8" CornerRadius="6" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="FTP Active" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="FTP Username" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBox x:Name="FtpUsernameTextBox" Text="root" Width="90" Height="28" Padding="6,2" FontSize="11" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="FTP Password" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <PasswordBox x:Name="FtpPasswordBox" Password="" Width="110" Height="28" Padding="6,2" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Progress Indicator -->
            <StackPanel Grid.Row="1" x:Name="TransferProgressPanel" Spacing="4" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock x:Name="TransferStatusText" Text="Starting transfer..." FontSize="11" Foreground="{StaticResource CyanAccentBrush}" />
                <ProgressBar x:Name="TransferProgressBar" Height="4" Background="#1D2939" Foreground="{StaticResource CyanAccentBrush}" CornerRadius="2" Minimum="0" Maximum="100" Value="0" />
            </StackPanel>

            <!-- Quick buttons -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto">
                <Button x:Name="ToggleCredentialsBtn" Grid.Column="0" Click="ToggleCredentialsBtn_Click" Style="{StaticResource OutlineButtonStyle}" Padding="12,8" Margin="0,0,8,0" ToolTipService.ToolTip="FTP Credentials">
                    <FontIcon Glyph="&#xE1F6;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                </Button>
                <Button x:Name="UploadFileBtn" Grid.Column="1" Click="UploadFileBtn_Click" Style="{StaticResource OutlineButtonStyle}" Padding="12,8" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE898;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        <TextBlock Text="Upload File" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="UploadFolderBtn" Grid.Column="2" Click="UploadFolderBtn_Click" Style="{StaticResource OutlineButtonStyle}" Padding="12,8" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8F4;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        <TextBlock Text="Upload Folder" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="DownloadBtn" Grid.Column="3" Click="DownloadBtn_Click" Style="{StaticResource CyanButtonStyle}" Padding="12,8" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        <TextBlock Text="Download Selected" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button x:Name="CloseBtn" Grid.Column="5" Click="CloseExplorer_Click" Style="{StaticResource OutlineButtonStyle}" Content="Close" Padding="20,8" />
            </Grid>
        </Grid>

        <!-- Inline New Folder dialog flyout popup container -->
        <Popup x:Name="NewFolderPopup" LightDismissOverlayMode="On" IsLightDismissEnabled="True" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="#1D2939" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Width="280">
                <StackPanel Spacing="12">
                    <TextBlock Text="Create New Folder" FontSize="13" FontWeight="Bold" Foreground="#F2F4F7" />
                    <TextBox x:Name="NewFolderNameTextBox" PlaceholderText="Folder name" KeyDown="NewFolderNameTextBox_KeyDown" />
                    <Grid ColumnDefinitions="*, *">
                        <Button Content="Cancel" Click="CancelNewFolder_Click" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,4,0" />
                        <Button Content="Create" Click="CreateNewFolder_Click" Style="{StaticResource CyanButtonStyle}" HorizontalAlignment="Stretch" Margin="4,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Stats/Properties Dialog popup container -->
        <Popup x:Name="PropertiesPopup" LightDismissOverlayMode="On" IsLightDismissEnabled="True" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="#1D2939" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Width="360">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Item Properties" FontSize="14" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" />
                        <Button Grid.Column="1" Click="CloseProperties_Click" Style="{StaticResource OutlineButtonStyle}" Padding="4" BorderThickness="0">
                            <FontIcon Glyph="&#xE10A;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        </Button>
                    </Grid>
                    
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PropertiesContainer" Spacing="10">
                            <TextBlock Text="Querying stats..." Foreground="#F2F4F7" FontSize="12" />
                        </StackPanel>
                    </ScrollViewer>

                    <Button Content="OK" Click="CloseProperties_Click" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Right" Width="80" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
