<UserControl
    x:Class="serial_console_dotnet.Controls.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:serial_console_dotnet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto, *, Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AllowDrop="True" DragOver="Terminal_DragOver" Drop="Terminal_Drop">
        <!-- Terminal Toolbar -->
        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Background="#0C1324" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE756;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource CyanAccentBrush}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock x:Name="TerminalTitleText" Text="Terminal Console (Offline)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="LineCountTextBlock" Text="0 lines logged" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Background="{StaticResource SlateDarkBrush}">
            <ListView x:Name="TerminalListView" 
                      SelectionMode="None" 
                      IsTabStop="True"
                      Background="Transparent" 
                      Padding="8"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      PreviewKeyDown="TerminalListView_KeyDown"
                      DoubleTapped="TerminalListView_DoubleTapped">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Copy" Click="CopyMenu_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Copy" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Clear Console" Click="ClearMenu_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Clear" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </ListView.ContextFlyout>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <local:TerminalLineControl Line="{Binding}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="18" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Border>

        <!-- Scroll Lock Indicator -->
        <Button Grid.Row="2" x:Name="ScrollLockIndicator" Click="ReleaseScrollLock_Click" HorizontalAlignment="Stretch" Background="#F59E0B" Foreground="#0F172A" CornerRadius="0" Padding="8,4" BorderThickness="0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                <TextBlock Text="Scroll Locked (Click to release)" FontSize="11" FontWeight="Bold" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
